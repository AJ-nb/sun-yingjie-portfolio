    {
      "page": 15,
      "kind": "evidence",
      "case": "periastra",
      "pageId": "wordmark",
      "title": "以选定字标方向建立一致识别",
      "body": "保留 2026 年 6 月 9 日 PERIASTRA 字体标志研究稿，用于比较字标、信息层级和应用秩序；商业采用状态和个人交付归属待核验。此页完整呈现选定方向研究稿，不以局部裁切代替尺寸可读性检查。",
      "images": [
        {
          "src": "/works/brand/periastra/final-wordmark.png",
          "caption": "PERIASTRA 字体标志研究稿"
        }
      ]
    },
