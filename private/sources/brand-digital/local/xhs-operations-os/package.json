{
  "name": "xhs-operations-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm --filter @xhs/web build",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "dev": "pnpm --filter @xhs/web dev",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "pnpm run typecheck:root && pnpm run typecheck:web && pnpm run typecheck:packages",
    "typecheck:packages": "pnpm --filter \"./packages/*\" run typecheck",
    "typecheck:root": "tsc --project tsconfig.base.json",
    "typecheck:web": "pnpm --filter @xhs/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
